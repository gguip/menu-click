# Copie para .env — os scripts do pacote carregam esse arquivo automaticamente
# (node --env-file-if-exists=.env), sem dotenv.

# ---- Postgres ----
# Use DATABASE_URL OU as variáveis DB_* abaixo (DATABASE_URL tem prioridade).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/capstone

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=capstone

# Máximo de conexões simultâneas no pool
DB_POOL_MAX=10

# ---- Server HTTP ----
PORT=3333
HOST=0.0.0.0

# A app está atrás de um reverse proxy (Nginx, ALB, Cloudflare...)?
#
# Ligue APENAS se houver mesmo um proxy à frente. Com `true`, a app confia no
# header `X-Forwarded-For` para saber o IP do cliente — o que é correto atrás
# de proxy e é um buraco se a app estiver exposta direto, porque aí qualquer um
# forja o header e escolhe o próprio IP.
#
# Com `false` atrás de um proxy o erro é o oposto: todo mundo aparece com o IP
# do proxy, e qualquer limite por IP passa a ser um teto compartilhado.
TRUST_PROXY=false

# Origens autorizadas a chamar a API de dentro de um navegador (CORS).
# Lista separada por vírgula. VAZIO = nenhuma origem cruzada passa.
#
# Deixe vazio até o front existir: falhar fechado quebra o front de forma
# visível, enquanto liberar demais é um problema que não dá sintoma nenhum.
# CORS_ORIGINS=http://localhost:5173,https://app.menuclick.com.br
CORS_ORIGINS=

# ---- E-mail (recuperação de senha) ----
# Qual driver envia o e-mail: `console` grava a mensagem inteira no log — só
# serve para dev, e a API recusa subir com ele quando NODE_ENV=production,
# porque o link que ele escreve no log É o token de recuperação (S13). `smtp`
# manda de verdade, via SMTP_URL.
EMAIL_DRIVER=console

# Connection string do servidor SMTP (só importa com EMAIL_DRIVER=smtp). Tem
# senha dentro — nunca commite um valor de verdade, nem um de dev (S12).
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com.br:465

# Remetente usado no envio por SMTP.
# EMAIL_FROM=MenuClick <nao-responda@menuclick.com.br>

# Base da URL pública para onde o e-mail de recuperação de senha aponta; o
# token vai anexado pela rota que monta o link.
# PASSWORD_RESET_URL=https://app.menuclick.com.br/recuperar-senha

# Base da URL pública para onde o e-mail de confirmação de cadastro aponta.
# Mesma ideia do PASSWORD_RESET_URL, para a verificação de e-mail.
# EMAIL_VERIFICATION_URL=https://app.menuclick.com.br/verificar-email
