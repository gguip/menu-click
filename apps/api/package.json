{
  "name": "@menuclick/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "migrate:up": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "node --env-file-if-exists=.env src/db/migrate.ts down",
    "migrate:create": "node-pg-migrate create -j sql",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "openapi:generate": "node --env-file-if-exists=.env src/openapi-write.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.11.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
